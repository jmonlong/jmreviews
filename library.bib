@article{Ostertag2003,
  title = {{{SVA Elements Are Nonautonomous Retrotransposons}} That {{Cause Disease}} in {{Humans}}},
  author = {Ostertag, Eric M and Goodier, John L and Zhang, Yue and Kazazian, Haig H},
  year = 2003,
  month = dec,
  journal = {The American Journal of Human Genetics},
  volume = {73},
  number = {6},
  pages = {1444--1451},
  issn = {00029297},
  doi = {10.1086/380207},
  abstract = {L1 elements are the only active autonomous retrotransposons in the human genome. The nonautonomous Alu elements, as well as processed pseudogenes, are retrotransposed by the L1 retrotransposition proteins working in trans. Here, we describe another repetitive sequence in the human genome, the SVA element. Our analysis reveals that SVA elements are currently active in the human genome. SVA elements, like Alus and L1s, occasionally insert into genes and cause disease. Furthermore, SVA elements are probably mobilized in trans by active L1 elements.},
  isbn = {0002-9297 (Print)\textbackslash r0002-9297 (Linking)},
  pmid = {14628287},
  keywords = {disease,sva,transposable-elements},
  file = {Ostertag et al/ostertag_et_al_2003_sva_elements_are_nonautonomous_retrotransposons_that_cause_disease_in_humans.pdf}
}

@article{Ostrovnaya2010,
  title = {A Classification Model for Distinguishing Copy Number Variants from Cancer-Related Alterations.},
  author = {Ostrovnaya, Irina and Nanjangud, Gouri and Olshen, Adam B},
