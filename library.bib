@article{Wang2019,
  title = {Statistical Methods for Genome-Wide Association Studies},
  author = {Wang, Maggie Haitian and Cordell, Heather J. and Van Steen, Kristel},
  year = 2019,
  month = apr,
  journal = {Seminars in Cancer Biology},
