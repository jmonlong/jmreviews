@article{Rodriguez-Garcia2021,
  title = {{{eG Coated Stents Exhibit Enhanced Endothelial Wound Healing Characteristics}}},
  author = {{Rodriguez-Garcia}, Belen and Bureau, Christophe and Barakat, Abdul I.},
  year = 2021,
  month = oct,
  journal = {Cardiovascular Engineering and Technology},
  volume = {12},
  number = {5},
  pages = {515--525},
  issn = {1869-4098},
  doi = {10.1007/s13239-021-00542-x},
  abstract = {PURPOSE: Despite their widespread use, a significant fraction of coronary stents suffer from in-stent restenosis and stent thrombosis. Stent deployment induces extensive injury to the vascular endothelium. Rapid endothelial wound closure is essential for the success of a stenting procedure. A recent study has demonstrated that the BuMA Supreme\textregistered{} sirolimus-eluting stent exhibits particularly attractive strut coverage characteristics. A unique feature of this stent is the presence of a thin brush layer of poly-butyl methacrylate (PBMA), covalently bonded to the stent's cobalt-chromium frame via electro-grafting (eG™). The present study aimed to determine whether the PBMA coating has an effect on endothelial cell wound healing and stent strut coverage. METHODS: We used an in vitro coronary artery model whose wall consisted of an annular collagen hydrogel and whose luminal surface was lined with a monolayer of endothelial cells. Mechanical wounding of the endothelial lining was preformed prior to deployment of a bare cobalt-chromium stent either with or without the PBMA layer. The migration of fluorescently labeled endothelial cells was monitored automatically over a period of 48 h to determine endothelial wound healing rates. RESULTS: Quantitative assessment of endothelial wound healing rates within the simulated arterial model is achievable using automated image analysis. Wound healing is significantly faster (44\% faster at 48 h) for stents with the PBMA eG Coating™ compared to bare metal stents. CONCLUSION: The PBMA eG Coating™ has the effect of promoting endothelial wound healing. Future studies will focus on elucidating the mechanistic basis of this observation.},
  langid = {english},
  pmcid = {PMC8481217},
  pmid = {34008078},
  keywords = {remove}
}

