  title = {Non-Invasive Diagnosis and Follow-up of Benign Liver Tumours},
  author = {Nault, Jean-Charles and Blanc, Jean-Fr{\'e}d{\'e}ric and Moga, Lucile and Calderaro, Julien and Dao, Th{\^o}ng and Guiu, Boris and Hocquelet, Arnaud and Paradis, Val{\'e}rie and Salam{\'e}, Ephrem and {de L{\'e}dinghen}, Victor and Bourli{\`e}re, Marc and Bureau, Christophe and {Ganne-Carri{\'e}}, Nathalie},
