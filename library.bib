@article{Corpechot2022,
  title = {Non-Invasive Diagnosis and Follow-up of Primary Biliary Cholangitis},
  author = {Corpechot, Christophe and Heurgue, Alexandra and Tanne, Florence and Potier, Pascal and Hanslik, Bertrand and Decraecker, Marie and {de L{\'e}dinghen}, Victor and {Ganne-Carri{\'e}}, Nathalie and Bureau, Christophe and Bourli{\`e}re, Marc},
  year = 2022,
  month = jan,
  journal = {Clinics and Research in Hepatology and Gastroenterology},
  volume = {46},
  number = {1},
  pages = {101770},
  issn = {2210-741X},
  doi = {10.1016/j.clinre.2021.101770},
  abstract = {Primary biliary cholangitis (PBC) is a chronic inflammatory disease of the intra-hepatic bile ducts [1]. It is characterised biologically by chronic cholestasis associated with the presence of specific autoantibodies, and histologically by lesions of nonsuppurative destructive cholangitis. If left untreated it can progress to cirrhosis, portal hypertension and liver failure. Diagnosis, staging and follow-up are largely based on non- or minimally-invasive assessment (blood tests, ultrasound, liver stiffness measurement). Histological examination of the liver and upper gastrointestinal endoscopy are sometimes necessary, but their indications remain limited. The purpose of this chapter is to provide the clinicians with what should be known about the non-invasive assessment of PBC and to provide specific recommendations for clinical practice.},
  langid = {english},
  pmid = {34332135}
}

