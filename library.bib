  author = {{NHGRI Centers for Common Disease Genomics} and Abel, Haley J. and Larson, David E. and Regier, Allison A. and Chiang, Colby and Das, Indraniel and Kanchi, Krishna L. and Layer, Ryan M. and Neale, Benjamin M. and Salerno, William J. and Reeves, Catherine and Buyske, Steven and Matise, Tara C. and Muzny, Donna M. and Zody, Michael C. and Lander, Eric S. and Dutcher, Susan K. and Stitziel, Nathan O. and Hall, Ira M.},
