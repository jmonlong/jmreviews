@article{Plessier2022,
  title = {Paroxysmal Nocturnal Hemoglobinuria and Vascular Liver Disease: {{Eculizumab}} Therapy Decreases Mortality and Thrombotic Complications},
  shorttitle = {Paroxysmal Nocturnal Hemoglobinuria and Vascular Liver Disease},
  author = {Plessier, Aur{\'e}lie and {Esposito-Far{\`e}se}, Marina and Baiges, Anna and Shukla, Akash and Garcia Pagan, Juan Carlos and De Raucourt, Emmanuelle and {Ollivier-Hourmand}, Isabelle and Cervoni, Jean-Paul and De Ledinghen, Victor and Tazi, Zoubida and Nousbaum, Jean-Baptiste and Bun, Ren{\'e} and Bureau, Christophe and Silvain, Christine and Tournilhac, Olivier and {Gerfaud-Valentin}, Mathieu and Durand, Fran{\c c}ois and Goria, Odile and Tellez, Luis and Albillos, Agustin and Gioia, Stefania and Riggio, Oliviero and De Gottardi, Andrea and Payance, Audrey and Rautou, Pierre-Emmanuel and Terriou, Louis and Charbonnier, Aude and Elkrief, Laure and {de la Tour}, Regis Peffault and Valla, Dominique-Charles and Gault, Nathalie and {de Fontbrune}, Flore Sicre},
  year = 2022,
