}

@article{Iakovishina2016,
  title = {{{SV-Bay}}: {{Structural}} Variant Detection in Cancer Genomes Using a {{Bayesian}} Approach with Correction for {{GC}}-Content and Read Mappability},
  author = {Iakovishina, Daria and {Janoueix-Lerosey}, Isabelle and Barillot, Emmanuel and Regnier, Mireille and Boeva, Valentina},
  year = 2016,
  journal = {Bioinformatics},
  volume = {32},
  number = {7},
  pages = {984--992},
  issn = {14602059},
  doi = {10.1093/bioinformatics/btv751},
  abstract = {MOTIVATION: Whole genome sequencing of paired-end reads can be applied to characterize the landscape of large somatic rearrangements of cancer genomes. Several methods for detecting structural variants with whole genome sequencing data have been developed. So far, none of these methods has combined information about abnormally mapped read pairs connecting rearranged regions and associated global copy number changes automatically inferred from the same sequencing data file. Our aim was to create a computational method that could use both types of information, i.e., normal and abnormal reads, and demonstrate that by doing so we can highly improve both sensitivity and specificity rates of structural variant prediction.\textbackslash n\textbackslash nRESULTS: We developed a computational method, SV-Bay, to detect structural variants from whole genome sequencing mate-pair or paired-end data using a probabilistic Bayesian approach. This approach takes into account depth of coverage by normal reads and abnormalities in read pair mappings. To estimate the model likelihood, SV-Bay considers GC-content and read mappability of the genome, thus making important corrections to the expected read count. For the detection of somatic variants, SV-Bay makes use of a matched normal sample when it is available. We validated SV-Bay on simulated datasets and an experimental mate-pair dataset for the CLB-GA neuroblastoma cell line. The comparison of SV-Bay with several other methods for structural variant detection demonstrated that SV-Bay has better prediction accuracy both in terms of sensitivity and false positive detection rate.\textbackslash n\textbackslash nAVAILABILITY: https://github.com/InstitutCurie/SV-Bay CONTACT: SV.Bay@curie.fr SUPPLEMENTARY INFORMATION: Available at Bioinformatics online.},
  isbn = {1367-4811 (Electronic)\textbackslash r1367-4803 (Linking)},
  pmid = {26740523},
  keywords = {bias,cancer,human,method,normalization,sequencing,sv,whole-genome},
