  author = {Gehlenborg, Nils and Noble, Michael S and Getz, Gad and Chin, Lynda and Park, Peter J},
  year = 2013,
  month = apr,
  journal = {Bioinformatics (Oxford, England)},
  volume = {29},
  number = {8},
  eprint = {23419376},
  eprinttype = {pubmed},
  pages = {1089--91},
  issn = {1367-4811},
  doi = {10.1093/bioinformatics/btt085},
  abstract = {We have developed Nozzle, an R package that provides an Application Programming Interface to generate HTML reports with dynamic user interface elements. Nozzle was designed to facilitate summarization and rapid browsing of complex results in data analysis pipelines where multiple analyses are performed frequently on big datasets. The package can be applied to any project where user-friendly reports need to be created.},
