@article{Ewing2020,
  title = {Nanopore Sequencing Enables Comprehensive Transposable Element Epigenomic Profiling},
  author = {Ewing, Adam D. and Smits, Nathan and {Sanchez-Luque}, Francisco J. and Faivre, Jamila and Brennan, Paul M. and Cheetham, Seth W. and Faulkner, Geoffrey J.},
