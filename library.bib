  pmid = {28436466},
  keywords = {de-novo,human,satellite,str,sv,tandem-repeat},
  file = {Willems et al/willems_et_al_2017_genome-wide_profiling_of_heritable_and_de_novo_str_variations.pdf;Willems et al/willems_et_al_2017_genome-wide_profiling_of_heritable_and_ide_novo-i_str_variations.pdf}
}

