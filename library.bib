@article{Siren2022,
  title = {{{GBZ}} File Format for Pangenome Graphs},
  author = {Sir{\'e}n, Jouni and Paten, Benedict},
  editor = {Martelli, Pier Luigi},
  year = 2022,
  month = nov,
  journal = {Bioinformatics},
