  author = {{Ganne-Carri{\'e}}, Nathalie and Fontaine, H{\'e}l{\`e}ne and Dumortier, J{\'e}r{\^o}me and Boursier, J{\'e}r{\^o}me and Bureau, Christophe and Leroy, Vincent and Bourli{\`e}re, Marc and {AFEF, French Association for the Study of the Liver}},
