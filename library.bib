@article{Delgado-Escueta2013,
  title = {The Quest for {{Juvenile Myoclonic Epilepsy}} Genes},
  author = {{Delgado-Escueta}, Antonio V and Koeleman, Bobby P.C. and Bailey, Julia N and Medina, Marco T and Dur{\'o}n, Reyna M},
  year = 2013,
