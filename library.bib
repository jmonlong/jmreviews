  shorttitle = {Angiography-Derived Physiology Guidance vs Usual Care in an {{All}}-Comers {{PCI}} Population Treated with the Healing-Targeted Supreme Stent and {{Ticagrelor}} Monotherapy},
  author = {Hara, Hironori and Serruys, Patrick W. and O'Leary, Neil and Gao, Chao and Murray, Alicia and Breslin, Elaine and Garg, Scot and Bureau, Christophe and Reiber, Johan Hc and Barbato, Emanuele and Aminian, Adel and Janssens, Luc and Rosseel, Liesbeth and Benit, Edouard and Campo, Gianluca and Guiducci, Vincenzo and Casella, Gianni and Santarelli, Andrea and Franz{\`e}, Alfonso and Diaz, Victor Alfonso Jimenez and I{\~n}iguez, Andr{\'e}s and Brugaletta, Salvatore and Sabate, Manel and {Amat-Santos}, Ignacio J. and Amoroso, Giovanni and Wykrzykowska, Joanna and {von Birgelen}, Clemens and Somi, Samer and Liu, Tommy and Hofma, Sjoerd H. and Curzen, Nick and Trillo, Ramiro and Ocaranza, Raymundo and Mathur, Anthony and Smits, Pieter C. and Escaned, Javier and Baumbach, Andreas and Wijns, William and Sharif, Faisal and Onuma, Yoshinobu and {PIONEER IV trial investigator}},
  year = 2022,
  month = apr,
  journal = {American Heart Journal},
  volume = {246},
