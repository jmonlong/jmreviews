@misc{Kronenberg2024,
  title = {The {{Platinum Pedigree}}: {{A}} Long-Read Benchmark for Genetic Variants},
  shorttitle = {The {{Platinum Pedigree}}},
  author = {Kronenberg, Zev and Nolan, Cillian and Mokveld, Tom and Rowell, William J and Lee, Sangjin and Dolzhenko, Egor and Chang, Pi-Chuan and Holt, James Matthew and Saunders, Christopher T and Olson, Nathanael D. and McGee, Sean and Guarracino, Andrea and Koundinya, Nidhi and Harvey, William T and Watkins, W. Scott and Munson, Katherine M and Hoekzema, Kendra and Chua, Khi Pin and Fanslow, Cairbre and Lambert, Christine and Dashnow, Harriet and Garrison, Erik and Smith, Josh and Lansdorp, Peter and Zook, Justin M and Carroll, Andrew and Jorde, Lynn B. and Neklason, Deborah W and Quinlan, Aaron and Eichler, Evan and Eberle, Michael A},
  year = 2024,
  month = oct,
  publisher = {Genomics},
  doi = {10.1101/2024.10.02.616333},
  urldate = {2025-10-12},
  abstract = {Recent advances in genome sequencing have improved variant calling in complex regions of the human genome. However, it is difficult to quantify variant calling performance since existing standards often focus on specificity, neglecting completeness in difficult to analyze regions. To create a more comprehensive truth set, we used Mendelian inheritance in a large pedigree (CEPH-1463) to filter variants across Illumina, PacBio high-fidelity (HiFi), and Oxford Nanopore Technologies platforms. This generated a variant map with over 4.7 million single-nucleotide variants, 767,795 indels, 537,486 tandem repeats, and 24,315 structural variants, covering 2.77 Gb of the GRCh38 genome. This work adds \textasciitilde 200 Mb of high-confidence regions, including 8\% more small variants, and introduces the first tandem repeat and structural variant truth sets for NA12878. As an example of the value of this improved benchmark, we retrained DeepVariant using this data to reduce genotyping errors by \textasciitilde 34\%.},
  archiveprefix = {Genomics},
  copyright = {http://creativecommons.org/licenses/by-nc-nd/4.0/},
  langid = {english},
  keywords = {benchmark,data,long-reads,sequencing,variant-calling},
  file = {Kronenberg/Kronenberg et al.-2024-the_platinum_pedigree_a_long-read_benchmark_for_genetic_variants.pdf}
}

@article{Krumm2012,
  type = {Journal Article},
  title = {Copy Number Variation Detection and Genotyping from Exome Sequence Data.},
  author = {Krumm, Niklas and Sudmant, Peter H. and Ko, Arthur and O'Roak, Brian J. and Malig, Maika and Coe, Bradley P. and Quinlan, Aaron R. and Nickerson, Deborah A. and Eichler, Evan E.},
