@article{Wake2024,
  title = {A Human Anti-Matriptase-2 Antibody Limits Iron Overload, {$\alpha$}-Globin Aggregates, and Splenomegaly in {$\beta$}-Thalassemic Mice},
  author = {Wake, Matthew and Palin, Ana{\"i}s and Belot, Audrey and Berger, Mathieu and Lorgouilloux, Megane and Bichon, Margot and Papworth, Jonathan and Bayliss, Luke and Grimshaw, Benjamin and Rynkiewicz, Natalie and Paterson, Jemima and Poindron, Alicia and Spearing, Erin and Carter, Emily and Hudson, Robyne and Campbell, Millie and Petzer, Verena and {Besson-Fournier}, C{\'e}line and Latour, Chlo{\'e} and Largounez, Am{\'e}lie and Gourbeyre, Oph{\'e}lie and Fay, Alexis and Coppin, H{\'e}l{\`e}ne and Roth, Marie-Paule and Theurl, Igor and Germaschewski, Volker and Meynard, Delphine},
  year = 2024,
  month = apr,
  journal = {Blood Advances},
  volume = {8},
  number = {8},
  pages = {1898--1907},
  issn = {2473-9537},
  doi = {10.1182/bloodadvances.2023012010},
  abstract = {Iron plays a major role in the deterioration of {$\beta$}-thalassemia. Indeed, the high levels of transferrin saturation and iron delivered to erythroid progenitors are associated with production of {$\alpha$}-globin precipitates that negatively affect erythropoiesis. Matriptase-2/TMPRSS6, a membrane-bound serine protease expressed in hepatocytes, negatively modulates hepcidin production and thus is a key target to prevent iron overload in {$\beta$}-thalassemia. To address safety concerns raised by the suppression of Tmprss6 by antisense oligonucleotides or small interfering RNA, we tested a fully human anti-matriptase-2 antibody, RLYB331, which blocks the protease activity of matriptase-2. When administered weekly to Hbbth3/+ mice, RLYB331 induced hepcidin expression, reduced iron loading, prevented the formation of toxic {$\alpha$}-chain/heme aggregates, reduced ros oxygen species formation, and improved reticulocytosis and splenomegaly. To increase the effectiveness of RLYB331 in {$\beta$}-thalassemia treatment even further, we administered RLYB331 in combination with RAP-536L, a ligand-trapping protein that contains the extracellular domain of activin receptor type IIB and alleviates anemia by promoting differentiation of late-stage erythroid precursors. RAP-536L alone did not prevent iron overload but significantly reduced apoptosis in the erythroid populations of the bone marrow, normalized red blood cell counts, and improved hemoglobin and hematocrit levels. Interestingly, the association of RLYB331 with RAP-536L entirely reversed the {$\beta$}-thalassemia phenotype in Hbbth3/+ mice and simultaneously corrected iron overload, ineffective erythropoiesis, splenomegaly, and hematological parameters, suggesting that a multifunctional molecule consisting of the fusion of RLYB331 with luspatercept (human version of RAP-536L) would allow administration of a single medication addressing simultaneously the different pathophysiological aspects of {$\beta$}-thalassemia.},
  langid = {english},
  pmcid = {PMC11021894},
  pmid = {38241484}
}

