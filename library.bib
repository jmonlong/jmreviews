@article{Moga2022,
  title = {Acute Kidney Injury in Patients with Cirrhosis: {{Prospective}} Longitudinal Study in 405 Patients},
  shorttitle = {Acute Kidney Injury in Patients with Cirrhosis},
  author = {Moga, Lucile and Robic, Marie-Ang{\`e}le and {Blasco-Perrin}, H{\'e}l{\`e}ne and Cabarrou, Pauline and Mogno, Julie and Guillaume, Ma{\"e}va and Vinel, Jean Pierre and P{\'e}ron, Jean-Marie and Bureau, Christophe},
